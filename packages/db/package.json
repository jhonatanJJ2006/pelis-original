{
  "name": "@pelis/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client-hooks.ts",
    "./api": "./src/api.ts",
    "./server": "./src/server.ts",
    "./registry": "./src/registry.ts",
    "./types": "./src/types.ts",
    "./auth": "./src/auth.ts",
    "./realtime": "./src/realtime.ts",
    "./storage": "./src/storage.ts",
    "./lib/vidnest-client": "./src/lib/vidnest-client.ts"
  },
  "scripts": {
    "dev": "prisma generate && echo 'db: ready'",
    "build": "prisma generate && echo 'db: built'",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx scripts/seed.ts",
    "import:convex": "dotenv -e ../../.env -- tsx scripts/import-convex-snapshot.ts",
    "import:anilist": "dotenv -e ../../.env -- tsx scripts/import-anilist-catalog.ts",
    "group:anime": "dotenv -e ../../.env -- tsx scripts/group-anime-series.ts",
    "playground:providers": "dotenv -e ../../.env -- tsx scripts/test-anime-providers.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@pelis/validators": "workspace:*",
    "better-auth": "1.4.9",
    "pg": "^8.13.1",
    "stripe": "^22.3.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pelis/eslint-config": "workspace:*",
    "@pelis/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.2",
    "eslint": "catalog:",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}