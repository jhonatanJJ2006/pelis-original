{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@pelis/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "tsBuildInfoFile": ".cache/tsbuildinfo.json"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
