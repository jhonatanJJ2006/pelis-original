{
  "name": "@pelis/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components": "./src/shared/ui/index.tsx",
    "./utils": "./src/shared/utils.ts",
    "./types": "./src/shared/types.ts",
    "./features/*": "./src/features/*/index.tsx",
    "./pages/*": "./src/pages/*/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pelis/auth": "workspace:*",
    "@pelis/db": "workspace:*",
    "@pelis/validators": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.447.0",
    "sonner": "^1.7.0",
    "swiper": "^14.0.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@pelis/eslint-config": "workspace:*",
    "@pelis/prettier-config": "workspace:*",
    "@pelis/tailwind-config": "workspace:*",
    "@pelis/tsconfig": "workspace:*",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@pelis/prettier-config"
}