{
  "name": "@pelis/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node ../../scripts/write-version.mjs",
    "build": "pnpm with-env next build",
    "build:vercel": "pnpm -w --filter @pelis/db exec prisma generate && next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "node scripts/find-port.js",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@pelis/auth": "workspace:*",
    "@pelis/db": "workspace:*",
    "@pelis/ui": "workspace:*",
    "@pelis/validators": "workspace:*",
    "@serwist/next": "8",
    "@serwist/precaching": "8",
    "@serwist/sw": "8",
    "@t3-oss/env-nextjs": "^0.11.1",
    "autoprefixer": "^10.4.20",
    "better-auth": "1.4.9",
    "geist": "catalog:",
    "hls.js": "^1.6.16",
    "next": "^14.2.15",
    "qrcode": "^1.5.4",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "resend": "^4.0.1",
    "sonner": "^1.7.0",
    "swiper": "^14.0.2",
    "tailwindcss": "catalog:",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@pelis/eslint-config": "workspace:*",
    "@pelis/prettier-config": "workspace:*",
    "@pelis/tailwind-config": "workspace:*",
    "@pelis/tsconfig": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.19.0",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "dotenv-cli": "^7.4.2",
    "jiti": "^1.21.6",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@pelis/prettier-config"
}
