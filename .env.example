# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pelis

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: NEXT_PUBLIC_SITE_URL also used as trusted origin / OAuth base.

# Google OAuth (Better Auth socialProviders.google)
# Prefer AUTH_GOOGLE_*; GOOGLE_CLIENT_* also accepted as aliases.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized JavaScript origins (examples):
#   http://localhost:3000
#   https://verpelis.pro
#   https://www.verpelis.pro
# Authorized redirect URIs (Better Auth callback — required):
#   http://localhost:3000/api/auth/callback/google
#   https://verpelis.pro/api/auth/callback/google
#   https://www.verpelis.pro/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Stripe — TEST MODE only (sk_test_ / pk_test_ / whsec_). Live keys are rejected in code.
# Dashboard → Developers → API keys (Test mode). Webhook: /api/stripe/webhook
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public URL used in checkout success/cancel redirects (must match Stripe)
SITE_URL=http://localhost:3000

# TMDB enrichment (optional)
TMDB_API_KEY=

# Anime streaming — Consumet API
# Self-hosted (recomendado): docker compose up -d consumet redis
CONSUMET_API_URL=http://localhost:3001
# Fallback público si no se define: https://api.consumet.org

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
