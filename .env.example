# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pelis

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Stripe (optional — suscripciones)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TMDB enrichment (optional)
TMDB_API_KEY=

# Anime streaming — Consumet API
# Self-hosted (recomendado): docker compose up -d consumet redis
CONSUMET_API_URL=http://localhost:3001
# Fallback público si no se define: https://api.consumet.org

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
