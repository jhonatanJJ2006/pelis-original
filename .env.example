# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pelis

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: NEXT_PUBLIC_SITE_URL also used as trusted origin / OAuth base.

# Google OAuth (Better Auth socialProviders.google)
# Prefer AUTH_GOOGLE_*; GOOGLE_CLIENT_* also accepted as aliases.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized JavaScript origins (examples):
#   http://localhost:3000
#   https://verpelis.pro
#   https://www.verpelis.pro
# Authorized redirect URIs (Better Auth callback — required):
#   http://localhost:3000/api/auth/callback/google
#   https://verpelis.pro/api/auth/callback/google
#   https://www.verpelis.pro/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Stripe — TEST MODE only (sk_test_ / pk_test_ / whsec_). Live keys are rejected in code.
# Runtime is Movies local (pelis-web + Postgres). verpelis.pro is a Cloudflare Tunnel to localhost:3000 — not Vercel.
# Dashboard webhook URL (prod): https://verpelis.pro/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, customer.subscription.*, invoice.paid, invoice.payment_failed
# Dev laptop: stripe listen --forward-to localhost:3000/api/stripe/webhook
# /subscribe/success also calls stripe.syncCheckoutSession so a missing webhook still activates the plan.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public URL used in checkout success/cancel redirects (must match Stripe).
# Movies prod: https://verpelis.pro — if this stays localhost, success/sync never hit the box.
SITE_URL=http://localhost:3000

# TMDB enrichment (optional)
TMDB_API_KEY=

# Anime streaming — Consumet API
# Self-hosted (recomendado): docker compose up -d consumet redis
CONSUMET_API_URL=http://localhost:3001
# Fallback público si no se define: https://api.consumet.org

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Android TWA (apps/android/android.keystore) — no commitear valores reales
# PELIS_STORE_PASS=
# PELIS_KEY_PASS=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_PASSWORD=
# BUBBLEWRAP_KEYSTORE_PASSWORD=
# BUBBLEWRAP_KEY_PASSWORD=

# E2E (opcional, nunca commitear valores reales)
# PELIS_TEST_USER_EMAIL=
# PELIS_TEST_USER_PASSWORD=
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
