{
  "name": "pelis",
  "private": true,
  "engines": {
    "node": "22.19.0",
    "pnpm": "9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "build:vercel": "pnpm install && pnpm exec turbo run build:vercel --filter=@pelis/web",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "start": "turbo start",
    "dev:web": "turbo watch dev -F @pelis/web...",
    "dev:convex": "turbo watch dev -F @pelis/convex...",
    "generate": "turbo gen",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@pelis/prettier-config": "workspace:*",
    "@turbo/gen": "^2.1.3",
    "prettier": "catalog:",
    "turbo": "^2.1.3",
    "typescript": "catalog:"
  },
  "prettier": "@pelis/prettier-config",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.11",
      "@types/react-dom": "18.3.1"
    }
  }
}
